#!/bin/sh
# Installed into .git/hooks by cargo-husky (runs on `cargo test`).
set -e
echo "pre-commit: cargo fmt --check"
cargo fmt --all -- --check
echo "pre-commit: cargo clippy -D warnings (with the runtime feature)"
cargo clippy --all-targets --features runtime --quiet -- -D warnings
echo "pre-commit: cargo test (with the runtime feature)"
cargo test --features runtime --quiet
